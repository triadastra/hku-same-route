# API key: never commit
.env
# Generated outputs (hundreds of MB) and downloaded map caches.
# For each finished run keep the analysis tables, the run summary, and the raw output compressed
# (the uncompressed files are over GitHub's size limit; run_experiments.sh pack makes the compressed files).
out/*
!out/day1/
!out/census_run/
!out/live_census/
out/*/*
!out/*/analysis/
!out/*/run_summary.json
!out/*/trips.jsonl.gz
!out/*/people.jsonl.gz
!out/*/agents.tar.gz
data/osm_*.json
__pycache__/
